# QRForge optional backend configuration.
#
# The static QR generator works 100% without any of this.
# These env vars only power DYNAMIC QR codes + analytics (Supabase).
#
# For Vercel deployment, add these in:
#   Vercel dashboard → Project → Settings → Environment Variables
# (then redeploy). Also run supabase/schema.sql in your Supabase project.

# Supabase project URL — e.g. https://abcxyz.supabase.co
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Storage bucket used to back up saved QR code records (default: qrforge-codes).
# Optional — schema.sql creates the default bucket automatically.
VITE_SUPABASE_BUCKET=qrforge-codes